@model Aspdotnetkar.ViewModels.BlogViewModel


<div class="page-header">
    <div class="container-adk">
        <div class="crumb"><a href="index.html">خانه</a><span> / وبلاگ</span></div>
        <h1>وبلاگ Aspdotnetkar</h1>
    </div>
</div>
<section class="section-tight bg-paper">
    <div class="container-adk">
        <div class="row g-4">
            <div class="col-lg-4 order-lg-2">
                <div class="side-box">
                    <h4>
                        <svg class="bi bi-search" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"></path>
                        </svg> جست‌وجو
                    </h4>
                    <form class="search-box js-demo-form">
                        <input type="text" placeholder="جست‌وجو در وبلاگ...">
                        <div class="small text-success d-none mt-2 form-status-msg"><span>نتایج جست‌وجو در نسخه‌ی نمایشی فعال نیست.</span></div>
                    </form>
                </div>
                <div class="side-box">
                    <h4>
                        <svg class="bi bi-folder2-open" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M1 3.5A1.5 1.5 0 0 1 2.5 2h2.764c.958 0 1.76.56 2.311 1.184C7.985 3.648 8.48 4 9 4h4.5A1.5 1.5 0 0 1 15 5.5v.64c.57.265.94.876.856 1.546l-.64 5.124A2.5 2.5 0 0 1 12.733 15H3.266a2.5 2.5 0 0 1-2.481-2.19l-.64-5.124A1.5 1.5 0 0 1 1 6.14zM2 6h12v-.5a.5.5 0 0 0-.5-.5H9c-.964 0-1.71-.629-2.174-1.154C6.374 3.334 5.82 3 5.264 3H2.5a.5.5 0 0 0-.5.5zm-.367 1a.5.5 0 0 0-.496.562l.64 5.124A1.5 1.5 0 0 0 3.266 14h9.468a1.5 1.5 0 0 0 1.489-1.314l.64-5.124A.5.5 0 0 0 14.367 7z"></path>
                        </svg> دسته‌بندی مطالب
                    </h4>
                    <ul class="category-list">
                        <li><a asp-action="showblog" asp-controller="allblogs" class="active">همه‌ی مطالب <span class="count">۵۱</span></a></li>
                        @foreach(var item in Model.Getcat)
                        {
                            <li><a href="blog.html">@item.BlogCategoryTitle</a><span class="count">@item.blogs.Count</span></li>
                        }
                        
                      
                    </ul>
                </div>
                <div class="side-box">
                    <h4>
                        <svg class="bi bi-fire" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 16c3.314 0 6-2 6-5.5 0-1.5-.5-4-2.5-6 .25 1.5-1.25 2-1.25 2C11 4 9 .5 6 0c.357 2 .5 4-2 6-1.25 1-2 2.729-2 4.5C2 14 4.686 16 8 16m0-1c-1.657 0-3-1-3-2.75 0-.75.25-2 1.25-3C6.125 10 7 10.5 7 10.5c-.375-1.25.5-3.25 2-3.5-.179 1-.25 2 1 3 .625.5 1 1.364 1 2.25C11 14 9.657 15 8 15"></path>
                        </svg> پربازدیدترین مطالب
                    </h4>
                    <div class="mini-post">
                        <div class="mini-cover cover-v1"><img class="img-fluid w-100 h-100" width="800" height="533" src="assets/img/other/premium_vector-1682309270309-bc01eee5d33a.png"></div>
                        <div>
                            <h6><a href="blog-single.html">راهنمای کامل Entity Framework Core برای مبتدیان</a></h6><span class="mini-meta">۴٬۲۱۰ بازدید</span>
                        </div>
                    </div>
                    <div class="mini-post">
                        <div class="mini-cover cover-v1"><img class="img-fluid w-100 h-100" width="800" height="533" src="assets/img/other/premium_vector-1682309270309-bc01eee5d33a.png"></div>
                        <div>
                            <h6><a href="blog-single.html">راهنمای کامل Entity Framework Core برای مبتدیان</a></h6><span class="mini-meta">۴٬۲۱۰ بازدید</span>
                        </div>
                    </div>
                    <div class="mini-post">
                        <div class="mini-cover cover-v1"><img class="img-fluid w-100 h-100" width="800" height="533" src="assets/img/other/premium_vector-1682309270309-bc01eee5d33a.png"></div>
                        <div>
                            <h6><a href="blog-single.html">راهنمای کامل Entity Framework Core برای مبتدیان</a></h6><span class="mini-meta">۴٬۲۱۰ بازدید</span>
                        </div>
                    </div>
                    <div class="mini-post">
                        <div class="mini-cover cover-v1"><img class="img-fluid w-100 h-100" width="800" height="533" src="assets/img/other/premium_vector-1682309270309-bc01eee5d33a.png"></div>
                        <div>
                            <h6><a href="blog-single.html">راهنمای کامل Entity Framework Core برای مبتدیان</a></h6><span class="mini-meta">۴٬۲۱۰ بازدید</span>
                        </div>
                    </div>
                </div>
                <div class="side-box">
                    <h4>
                        <svg class="bi bi-tags" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M3 2v4.586l7 7L14.586 9l-7-7zM2 2a1 1 0 0 1 1-1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586z"></path>
                            <path d="M5.5 5a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1m0 1a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3M1 7.086a1 1 0 0 0 .293.707L8.75 15.25l-.043.043a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 0 7.586V3a1 1 0 0 1 1-1z"></path>
                        </svg> برچسب‌ها
                    </h4>
                    <div class="tag-cloud"><a href="blog.html">ASP.NET Core</a><a href="blog.html">CSharp</a><a href="blog.html">Entity Framework</a><a href="blog.html">SQL Server</a><a href="blog.html">Blazor</a><a href="blog.html">امنیت</a><a href="blog.html">سئو</a><a href="blog.html">Bootstrap</a><a href="blog.html">API</a></div>
                </div>
            </div>
            <div class="col-lg-8 order-lg-1">
                <div class="row g-4">
                    @foreach (var item in Model.AllBlog)
                    {
                        <div class="col-md-6 col-xl-4">
                            <article class="blog-card">
                                <a href="blog-single.html" class="blog-cover cover-v1"><img class="img-fluid w-100 h-100" width="3117" height="4675" src="/assets/img/other/a-c-NqXqLPhdbvU-unsplash.jpg"></a>
                                <div class="blog-card__body">
                                    <span class="cat-pill">@item.BlogCategory.BlogCategoryTitle</span>
                                    <h3>@item.BlogTitle</h3>
                                    <p>@item.BlogShortdescription</p>
                                    <div class="meta-row">
                                        <span class="meta-item">
                                            <svg class="bi bi-calendar3" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16">
                                                <path d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2M1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857z"></path>
                                                <path d="M6.5 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2"></path>
                                            </svg> @item.BlogCreateDate
                                        </span><span class="meta-item">
                                        <svg class="bi bi-eye" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"></path>
                                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"></path>
                                        </svg> @item.BlogVisitCount
                                    </span>
                                </div>
                            </div>
                        </article>
                    </div>
                }

                    
            </div>


            <nav class="pagination-adk" aria-label="صفحه‌بندی وبلاگ">
                <a href="blog.html">
                    <svg class="bi bi-chevron-right" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"></path>
                    </svg>
                </a><a href="blog.html" class="active">۱</a><a href="blog.html">۲</a><a href="blog.html">۳</a><a href="blog.html">
                <svg class="bi bi-chevron-left" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"></path>
                </svg>
            </a>
        </nav>
    </div>
</div>
</div>
</section>


